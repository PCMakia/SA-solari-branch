# Path to Sleeper Agent queue state (defaults to ~/.sleeper_agent/queue_state.json)
SLEEPER_STATE_PATH=

# Display label in dashboard header (match SLEEPER_BACKEND in mcp.json)
SLEEPER_BACKEND=solari

# Optional: for future Solari replay proxy routes (not required today)
# Task execution uses SOLARI_API_KEY in ~/.cursor/mcp.json instead.
SOLARI_API_KEY=